#: prefs.js:112
msgid "Appearance"
msgstr "外观"

#: prefs.js:116
msgid "Code Rain"
msgstr "代码雨"

#: prefs.js:117
msgid "Tune the rain for your display setup."
msgstr "调整代码雨以适合您的显示设置。"

#: prefs.js:125
msgid "Phosphor glow"
msgstr "磷光辉光"

#: prefs.js:126
msgid "Add a single-pass halo."
msgstr "添加单次渲染光晕。"

#: prefs.js:132
msgid "Soft anti-aliasing"
msgstr "柔和抗锯齿"

#: prefs.js:133
msgid "Blend adjacent glyph samples for a softer cinematic bloom."
msgstr "混合相邻字形采样，营造更柔和的电影感辉光。"

#: prefs.js:137
msgid "Font size"
msgstr "字体大小"

#: prefs.js:138
msgid "Larger glyphs use fewer columns and fewer compositor resources."
msgstr "较大的字形会减少列数并降低合成器资源占用。"

#: prefs.js:146
msgid "Glyph scale"
msgstr "字形缩放"

#: prefs.js:147
msgid "Set the actual percentage of each grid cell filled by its symbol."
msgstr "设置符号实际填充每个网格单元的百分比。"

#: prefs.js:155
msgid "Rain speed"
msgstr "下落速度"

#: prefs.js:156
msgid "Control how quickly streams fall and glyphs change."
msgstr "控制代码流下落和字形变化的速度。"

#: prefs.js:164
msgid "Stream density"
msgstr "代码流密度"

#: prefs.js:165
msgid "Increase or reduce the number of independent code streams."
msgstr "增加或减少独立代码流的数量。"

#: prefs.js:173
msgid "Transparency"
msgstr "透明度"

#: prefs.js:174
msgid "Lower this for a subtle effect over the desktop."
msgstr "降低此值可在桌面上获得更细腻的效果。"

#: prefs.js:186
msgid "About"
msgstr "关于"

#: prefs.js:192
msgid "Matrix Code Rain"
msgstr "Matrix 代码雨"

#: metadata.json:3
msgid ""
"Matrix animated green code rain behind your windows on every workspace and "
"monitor.\n"
"\n"
"Requires a GPU to run."
msgstr ""
"在每个工作区和显示器的窗口后方显示 Matrix 风格的绿色动态代码雨。\n"
"\n"
"需要 GPU 才能运行。"

#: prefs.js:193
msgid "Matrix-style animated code rain for the GNOME desktop."
msgstr "GNOME 桌面的 Matrix 风格动态代码雨。"

#: prefs.js:205
msgid "Buy me a coffee ☕"
msgstr "请我喝杯咖啡 ☕"

#: prefs.js:210
msgid "Report a Bug 🐞"
msgstr "报告问题 🐞"

#: prefs.js:214
msgid "Request a Feature 💡"
msgstr "请求新功能 💡"

#: prefs.js:220
msgid "Developer"
msgstr "开发者"

#: prefs.js:223
msgid "Local / EGO (Auto-injected)"
msgstr "本地 / EGO（自动注入）"

#: prefs.js:227
msgid "Version"
msgstr "版本"

#: prefs.js:231
msgid "Graphics requirement"
msgstr "图形要求"

#: prefs.js:232
msgid ""
"Requires an OpenGL-capable compositor; CPU-only rendering is not supported."
msgstr "需要支持 OpenGL 的合成器；不支持纯 CPU 渲染。"

#: shell/errorNotification.js:13
msgid "Matrix Code could not start"
msgstr "Matrix 代码无法启动"

#: shell/errorNotification.js:14
msgid ""
"GNOME could not create the required OpenGL effect. This is likely because "
"your system has no GPU or lacks the required OpenGL support."
msgstr ""
"GNOME 无法创建所需的 OpenGL 效果。可能是系统没有 GPU 或缺少所需的 OpenGL "
"支持。"

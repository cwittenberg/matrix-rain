#: prefs.js:112
msgid "Appearance"
msgstr "Aspetto"

#: prefs.js:116
msgid "Code Rain"
msgstr "Pioggia di codice"

#: prefs.js:117
msgid "Tune the rain for your display setup."
msgstr "Adatta la pioggia alla configurazione degli schermi."

#: prefs.js:125
msgid "Phosphor glow"
msgstr "Bagliore al fosforo"

#: prefs.js:126
msgid "Add a single-pass halo."
msgstr "Aggiunge un alone in un singolo passaggio."

#: prefs.js:132
msgid "Soft anti-aliasing"
msgstr "Anti-aliasing morbido"

#: prefs.js:133
msgid "Blend adjacent glyph samples for a softer cinematic bloom."
msgstr "Fonde i campioni dei glifi adiacenti per un bagliore cinematografico più morbido."

#: prefs.js:137
msgid "Font size"
msgstr "Dimensione del carattere"

#: prefs.js:138
msgid "Larger glyphs use fewer columns and fewer compositor resources."
msgstr "Glifi più grandi usano meno colonne e meno risorse del compositore."

#: prefs.js:146
msgid "Glyph scale"
msgstr "Scala dei glifi"

#: prefs.js:147
msgid "Set the actual percentage of each grid cell filled by its symbol."
msgstr "Imposta la percentuale effettiva di ogni cella occupata dal simbolo."

#: prefs.js:155
msgid "Rain speed"
msgstr "Velocità della pioggia"

#: prefs.js:156
msgid "Control how quickly streams fall and glyphs change."
msgstr "Controlla la velocità di caduta dei flussi e di modifica dei glifi."

#: prefs.js:164
msgid "Stream density"
msgstr "Densità dei flussi"

#: prefs.js:165
msgid "Increase or reduce the number of independent code streams."
msgstr "Aumenta o riduce il numero di flussi di codice indipendenti."

#: prefs.js:173
msgid "Transparency"
msgstr "Trasparenza"

#: prefs.js:174
msgid "Lower this for a subtle effect over the desktop."
msgstr "Riduci questo valore per un effetto discreto sul desktop."

#: prefs.js:186
msgid "About"
msgstr "Informazioni"

#: prefs.js:192
msgid "Matrix Code Rain"
msgstr "Pioggia di codice Matrix"

#: metadata.json:3
msgid ""
"Matrix animated green code rain behind your windows on every workspace and "
"monitor.\n"
"\n"
"Requires a GPU to run."
msgstr ""
"Pioggia animata di codice verde Matrix dietro le finestre, in ogni spazio di "
"lavoro e monitor.\n"
"\n"
"Richiede una GPU."

#: prefs.js:193
msgid "Matrix-style animated code rain for the GNOME desktop."
msgstr "Pioggia di codice animata in stile Matrix per il desktop GNOME."

#: prefs.js:205
msgid "Buy me a coffee ☕"
msgstr "Offrimi un caffè ☕"

#: prefs.js:210
msgid "Report a Bug 🐞"
msgstr "Segnala un problema 🐞"

#: prefs.js:214
msgid "Request a Feature 💡"
msgstr "Richiedi una funzionalità 💡"

#: prefs.js:220
msgid "Developer"
msgstr "Sviluppatore"

#: prefs.js:223
msgid "Local / EGO (Auto-injected)"
msgstr "Locale / EGO (inserita automaticamente)"

#: prefs.js:227
msgid "Version"
msgstr "Versione"

#: prefs.js:231
msgid "Graphics requirement"
msgstr "Requisiti grafici"

#: prefs.js:232
msgid ""
"Requires an OpenGL-capable compositor; CPU-only rendering is not supported."
msgstr "Richiede un compositore compatibile con OpenGL; il rendering con la sola CPU non è supportato."

#: shell/errorNotification.js:13
msgid "Matrix Code could not start"
msgstr "Impossibile avviare il codice Matrix"

#: shell/errorNotification.js:14
msgid ""
"GNOME could not create the required OpenGL effect. This is likely because "
"your system has no GPU or lacks the required OpenGL support."
msgstr "GNOME non ha potuto creare l’effetto OpenGL richiesto. Probabilmente il sistema non dispone di una GPU o del supporto OpenGL necessario."

#: prefs.js:112
msgid "Appearance"
msgstr "Apparence"

#: prefs.js:116
msgid "Code Rain"
msgstr "Pluie de code"

#: prefs.js:117
msgid "Tune the rain for your display setup."
msgstr "Adaptez la pluie à votre configuration d’affichage."

#: prefs.js:125
msgid "Phosphor glow"
msgstr "Lueur phosphorescente"

#: prefs.js:126
msgid "Add a single-pass halo."
msgstr "Ajoute un halo en une seule passe."

#: prefs.js:132
msgid "Soft anti-aliasing"
msgstr "Anticrénelage doux"

#: prefs.js:133
msgid "Blend adjacent glyph samples for a softer cinematic bloom."
msgstr "Mélange les échantillons de glyphes voisins pour une lueur cinématographique plus douce."

#: prefs.js:137
msgid "Font size"
msgstr "Taille de police"

#: prefs.js:138
msgid "Larger glyphs use fewer columns and fewer compositor resources."
msgstr "Des glyphes plus grands utilisent moins de colonnes et de ressources du compositeur."

#: prefs.js:146
msgid "Glyph scale"
msgstr "Échelle des glyphes"

#: prefs.js:147
msgid "Set the actual percentage of each grid cell filled by its symbol."
msgstr "Définit le pourcentage réel de chaque cellule occupé par son symbole."

#: prefs.js:155
msgid "Rain speed"
msgstr "Vitesse de la pluie"

#: prefs.js:156
msgid "Control how quickly streams fall and glyphs change."
msgstr "Contrôle la vitesse de chute des flux et de changement des glyphes."

#: prefs.js:164
msgid "Stream density"
msgstr "Densité des flux"

#: prefs.js:165
msgid "Increase or reduce the number of independent code streams."
msgstr "Augmente ou réduit le nombre de flux de code indépendants."

#: prefs.js:173
msgid "Transparency"
msgstr "Transparence"

#: prefs.js:174
msgid "Lower this for a subtle effect over the desktop."
msgstr "Réduisez cette valeur pour un effet discret sur le bureau."

#: prefs.js:186
msgid "About"
msgstr "À propos"

#: prefs.js:192
msgid "Matrix Code Rain"
msgstr "Pluie de code Matrix"

#: metadata.json:3
msgid ""
"Matrix animated green code rain behind your windows on every workspace and "
"monitor.\n"
"\n"
"Requires a GPU to run."
msgstr ""
"Pluie animée de code vert Matrix derrière vos fenêtres, sur tous les espaces "
"de travail et moniteurs.\n"
"\n"
"Nécessite un processeur graphique."

#: prefs.js:193
msgid "Matrix-style animated code rain for the GNOME desktop."
msgstr "Pluie de code animée de style Matrix pour le bureau GNOME."

#: prefs.js:205
msgid "Buy me a coffee ☕"
msgstr "Offrez-moi un café ☕"

#: prefs.js:210
msgid "Report a Bug 🐞"
msgstr "Signaler un bug 🐞"

#: prefs.js:214
msgid "Request a Feature 💡"
msgstr "Proposer une fonctionnalité 💡"

#: prefs.js:220
msgid "Developer"
msgstr "Développeur"

#: prefs.js:223
msgid "Local / EGO (Auto-injected)"
msgstr "Locale / EGO (injectée automatiquement)"

#: prefs.js:227
msgid "Version"
msgstr "Version"

#: prefs.js:231
msgid "Graphics requirement"
msgstr "Configuration graphique requise"

#: prefs.js:232
msgid ""
"Requires an OpenGL-capable compositor; CPU-only rendering is not supported."
msgstr "Nécessite un compositeur compatible OpenGL ; le rendu uniquement par processeur n’est pas pris en charge."

#: shell/errorNotification.js:13
msgid "Matrix Code could not start"
msgstr "Impossible de démarrer le code Matrix"

#: shell/errorNotification.js:14
msgid ""
"GNOME could not create the required OpenGL effect. This is likely because "
"your system has no GPU or lacks the required OpenGL support."
msgstr "GNOME n’a pas pu créer l’effet OpenGL requis. Votre système ne possède probablement pas de processeur graphique ou ne fournit pas la prise en charge OpenGL nécessaire."

#: prefs.js:112
msgid "Appearance"
msgstr "Apariencia"

#: prefs.js:116
msgid "Code Rain"
msgstr "Lluvia de código"

#: prefs.js:117
msgid "Tune the rain for your display setup."
msgstr "Ajusta la lluvia a la configuración de tus pantallas."

#: prefs.js:125
msgid "Phosphor glow"
msgstr "Brillo fosforescente"

#: prefs.js:126
msgid "Add a single-pass halo."
msgstr "Añade un halo en una sola pasada."

#: prefs.js:132
msgid "Soft anti-aliasing"
msgstr "Suavizado de bordes"

#: prefs.js:133
msgid "Blend adjacent glyph samples for a softer cinematic bloom."
msgstr "Mezcla muestras de glifos adyacentes para obtener un resplandor cinematográfico más suave."

#: prefs.js:137
msgid "Font size"
msgstr "Tamaño de fuente"

#: prefs.js:138
msgid "Larger glyphs use fewer columns and fewer compositor resources."
msgstr "Los glifos más grandes usan menos columnas y menos recursos del compositor."

#: prefs.js:146
msgid "Glyph scale"
msgstr "Escala de glifos"

#: prefs.js:147
msgid "Set the actual percentage of each grid cell filled by its symbol."
msgstr "Define el porcentaje real de cada celda que ocupa su símbolo."

#: prefs.js:155
msgid "Rain speed"
msgstr "Velocidad de la lluvia"

#: prefs.js:156
msgid "Control how quickly streams fall and glyphs change."
msgstr "Controla la velocidad de caída de los flujos y el cambio de los glifos."

#: prefs.js:164
msgid "Stream density"
msgstr "Densidad de flujos"

#: prefs.js:165
msgid "Increase or reduce the number of independent code streams."
msgstr "Aumenta o reduce el número de flujos de código independientes."

#: prefs.js:173
msgid "Transparency"
msgstr "Transparencia"

#: prefs.js:174
msgid "Lower this for a subtle effect over the desktop."
msgstr "Reduce este valor para obtener un efecto sutil sobre el escritorio."

#: prefs.js:186
msgid "About"
msgstr "Acerca de"

#: prefs.js:192
msgid "Matrix Code Rain"
msgstr "Lluvia de código Matrix"

#: metadata.json:3
msgid ""
"Matrix animated green code rain behind your windows on every workspace and "
"monitor.\n"
"\n"
"Requires a GPU to run."
msgstr ""
"Lluvia animada de código verde Matrix detrás de las ventanas, en todos los "
"espacios de trabajo y monitores.\n"
"\n"
"Requiere una GPU para funcionar."

#: prefs.js:193
msgid "Matrix-style animated code rain for the GNOME desktop."
msgstr "Lluvia animada de código estilo Matrix para el escritorio GNOME."

#: prefs.js:205
msgid "Buy me a coffee"
msgstr "Invítame a un café"

#: prefs.js:210
msgid "Report a Bug"
msgstr "Informar de un error"

#: prefs.js:214
msgid "Request a Feature"
msgstr "Solicitar una función"

#: prefs.js:220
msgid "Developer"
msgstr "Desarrollador"

#: prefs.js:223
msgid "Local / EGO (Auto-injected)"
msgstr "Local / EGO (inyectada automáticamente)"

#: prefs.js:227
msgid "Version"
msgstr "Versión"

#: prefs.js:231
msgid "Graphics requirement"
msgstr "Requisito gráfico"

#: prefs.js:232
msgid ""
"Requires an OpenGL-capable compositor; CPU-only rendering is not supported."
msgstr "Requiere un compositor compatible con OpenGL; no se admite el renderizado solo mediante CPU."

#: shell/errorNotification.js:13
msgid "Matrix Code could not start"
msgstr "No se pudo iniciar el código Matrix"

#: shell/errorNotification.js:14
msgid ""
"GNOME could not create the required OpenGL effect. This is likely because "
"your system has no GPU or lacks the required OpenGL support."
msgstr "GNOME no pudo crear el efecto OpenGL requerido. Es probable que el sistema no tenga GPU o carezca de la compatibilidad OpenGL necesaria."
